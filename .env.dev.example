# Local stack settings. stack-up.sh copies this to .env.dev (git-ignored) and fills
# every replace-me value with a generated secret. Never commit .env.dev.

APP_NAME=geomind-dev
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

JWT_SECRET_KEY=replace-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=example-password

LOCAL_ADMIN_EMAIL=sahand@example.com
LOCAL_ADMIN_PASSWORD=replace-me

POSTGRES_USER=geomind
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=geomind
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+asyncpg://geomind:replace-me@127.0.0.1:5432/geomind

REDIS_PASSWORD=replace-me
REDIS_PORT=6379
REDIS_URL=redis://default:replace-me@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://default:replace-me@127.0.0.1:6379/1

MINIO_ROOT_USER=geomind
MINIO_ROOT_PASSWORD=replace-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=geomind
MINIO_SECRET_KEY=replace-me
MINIO_SECURE=false
MINIO_BUCKET_NAME=geomind

API_PORT=8000
FRONTEND_PORT=5173

RATE_LIMIT_REQUESTS=5000
OPENROUTER_API_KEY=
GEOMIND_ANALYSISLEAD_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_CASELEAD_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_COORDINATOR_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_DESIGNLEAD_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_ECONOMIST_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_EXPLAINER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_GEOSCIENTIST_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_REVIEWER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_SUMMARIZER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_PROCESSENGINEER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_INTEGRATIONENGINEER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_RESERVOIRENGINEER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_WELLENGINEER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_ENERGYSYSTEMSENGINEER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_PROJECTLEAD_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_SUPPORTLEAD_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_CURATOR_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_PROVIDER=deepseek
GEOMIND_CONTEXT_WINDOW=128000
GEOMIND_MAX_STEPS=30
GEOMIND_MAX_OUTPUT_TOKENS=16000
GEOMIND_RETRY_COUNT=5
GEOMIND_RETRY_DELAY=2
GEOMIND_DESIGN_CONCURRENCY=3
GEOMIND_ENGINEER_MAX_STEPS=15
GEOMIND_EVOLVE_EVALUATIONS=60
GEOMIND_EVOLVE_POPULATION=12
GEOMIND_EVOLVE_SEED=0
GEOMIND_EVOLVE_POLISH=0
GEOMIND_MEMORY=on
GEOMIND_MEMORY_SIMILARITY=0.8
GEOMIND_MCP_TIMEOUT=30
MALLOC_ARENA_MAX=2

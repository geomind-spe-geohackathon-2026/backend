# Application
APP_NAME=swarmax-backend
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_VERSION=0.1.0
APP_CORS_ORIGINS='["http://localhost:5173","https://swarmax.xyz","https://www.swarmax.xyz","https://studio.swarmax.xyz","https://admin.swarmax.xyz","https://dashboard.swarmax.xyz"]'


# Security
JWT_SECRET_KEY=replace-with-a-random-64-character-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30


# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://admin:replace-with-postgres-password@postgres:5432/swarmax
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10


# Redis
REDIS_URL=redis://default:replace-with-redis-password@redis:6379/0


# Celery
CELERY_BROKER_URL=redis://default:replace-with-redis-password@redis:6379/1


# Rate limit
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60


# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace-with-minio-password
MINIO_SECURE=false
MINIO_BUCKET_NAME=swarmax


# ChromaDB
CHROMADB_URL=http://chromadb:8000


# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=replace-with-influxdb-token
INFLUXDB_ORG=swarmax
INFLUXDB_BUCKET=swarmax


# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-openrouter-api-key

# Application
APP_NAME=geomind-backend
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_VERSION=0.1.0
APP_CORS_ORIGINS='["http://localhost:5173","https://geomind.team"]'


# Security
JWT_SECRET_KEY=replace-with-a-random-64-character-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14


# First admin, created at startup when no admin exists
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=replace-with-first-admin-password


# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://admin:replace-with-postgres-password@postgres:5432/geomind
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10


# Redis
REDIS_URL=redis://default:replace-with-redis-password@redis:6379/0


# Celery
CELERY_BROKER_URL=redis://default:replace-with-redis-password@redis:6379/1


# Rate limit
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60


# Project import, limit on the upload and on its unpacked size
PROJECT_IMPORT_MAX_BYTES=100000000


# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace-with-minio-password
MINIO_SECURE=false
MINIO_BUCKET_NAME=geomind


# ChromaDB
CHROMADB_URL=http://chromadb:8000


# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=replace-with-influxdb-token
INFLUXDB_ORG=geomind
INFLUXDB_BUCKET=geomind


# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-openrouter-api-key
GEOMIND_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_CHEAP_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_PROVIDER=relace/fp4
GEOMIND_CONTEXT_WINDOW=128000

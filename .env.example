# Application
APP_NAME=geomind-backend
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS='["http://localhost:5173","https://geomind.team"]'


# Security
JWT_SECRET_KEY=replace-with-a-random-64-character-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14


# First admin, created at startup when no admin exists
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=replace-with-first-admin-password


# PostgreSQL
POSTGRES_URL=postgresql+asyncpg://admin:replace-with-postgres-password@postgres:5432/geomind
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=20


# Redis
REDIS_URL=redis://default:replace-with-redis-password@redis:6379/0


# Celery
CELERY_BROKER_URL=redis://default:replace-with-redis-password@redis:6379/1


# Rate limit
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60


# Project import, limit on the upload and on its unpacked size
PROJECT_IMPORT_MAX_BYTES=100000000


# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace-with-minio-password
MINIO_SECURE=false
MINIO_BUCKET_NAME=geomind


# ChromaDB
CHROMADB_URL=http://chromadb:8000


# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=replace-with-influxdb-token
INFLUXDB_ORG=geomind
INFLUXDB_BUCKET=geomind


# Assistant: the token cap of one run over all its calls (a cost guard, not a context limit), or off
ASSISTANT_RUN_MAX_TOKENS=10000000


# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-openrouter-api-key
GEOMIND_ANALYSISLEAD_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_CASELEAD_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_COORDINATOR_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_DESIGNLEAD_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_ECONOMIST_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_EXPLAINER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_GEOSCIENTIST_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_REVIEWER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_SUMMARIZER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_PROCESSENGINEER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_INTEGRATIONENGINEER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_RESERVOIRENGINEER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_WELLENGINEER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_ENERGYSYSTEMSENGINEER_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_PROJECTLEAD_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_SUPPORTLEAD_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_CURATOR_MODEL=deepseek/deepseek-v4.1-flash-1017
GEOMIND_PROVIDER=morph/fp8
GEOMIND_CONTEXT_WINDOW=200000
GEOMIND_MAX_STEPS=30
GEOMIND_MAX_OUTPUT_TOKENS=16000
GEOMIND_RETRY_COUNT=5
GEOMIND_RETRY_DELAY=2
GEOMIND_DESIGN_CONCURRENCY=3
GEOMIND_TEAM_SIZE=8
GEOMIND_COMPARE_CONCURRENCY=3
GEOMIND_COMPARE_RETRIES=1
GEOMIND_ENGINEER_MAX_STEPS=15
GEOMIND_EVOLVE_EVALUATIONS=60
GEOMIND_EVOLVE_POPULATION=12
GEOMIND_EVOLVE_SEED=0
GEOMIND_EVOLVE_POLISH=0
GEOMIND_EVOLVE_STOP_GENERATIONS=off
GEOMIND_EVOLVE_STOP_SECONDS=off
GEOMIND_MEMORY=on
GEOMIND_MEMORY_SIMILARITY=0.8
GEOMIND_MCP_TIMEOUT=30
MALLOC_ARENA_MAX=2


# Local stack only (compose.dev.yml); a deploy leaves them as they are
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=replace-me
POSTGRES_USER=geomind
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=geomind
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-me
REDIS_PORT=6379
MINIO_ROOT_USER=geomind
MINIO_ROOT_PASSWORD=replace-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
FRONTEND_PORT=5173

# Agent tools (feature agent-tools-2026-11-05)
# The host's docker group id, for the worker's sandbox containers.
DOCKER_GID=1001
ASSISTANT_SANDBOX=docker
GEOMIND_SANDBOX_IMAGE=gemini-sandbox:0.6.5
GEOMIND_SANDBOX_TIMEOUT=60s
GEOMIND_SANDBOX_MEMORY=1g
GEOMIND_SANDBOX_DISK=256m
GEOMIND_SANDBOX_CPU=1
# SearXNG on the internal network (../infrastructure/searxng).
GEOMIND_SEARCH_URL=http://searxng:8080
